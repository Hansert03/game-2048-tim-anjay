        nameLabel.setForeground(new Color(119, 110, 101));

        JLabel controlLabel = new JLabel(controlsText);
        controlLabel.setFont(new Font("Arial", Font.PLAIN, 14));
        controlLabel.setForeground(new Color(119, 110, 101));

        titlePanel.add(nameLabel);

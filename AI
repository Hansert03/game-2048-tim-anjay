    public Game2048 getGame() {
        return game;
    }

    public void updateView(boolean stopAt2048) {
        scoreLabel.setText(String.valueOf(game.getScore()));
        bestScoreLabel.setText(String.valueOf(game.getBestScore()));
        boardPanel.repaint();

        if (game.isGameOver()) {
            statusLabel.setText("Game Over");
        } else if (stopAt2048 && game.hasWon()) {
            statusLabel.setText("Mencapai 2048!");
        } else {
            statusLabel.setText(" ");
        }
    }
}

class BoardPanel extends JPanel {
    private final Game2048 game;

    public BoardPanel(Game2048 game) {
        this.game = game;
        setBackground(new Color(187, 173, 160));
        setPreferredSize(new Dimension(430, 430));
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);

        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        int boardSize = Math.min(getWidth(), getHeight());
        int startX = (getWidth() - boardSize) / 2;
        int startY = (getHeight() - boardSize) / 2;

        int gap = 12;
        int cellSize = (boardSize - gap * 5) / 4;

        int[][] grid = game.getGrid();

        for (int row = 0; row < 4; row++) {
            for (int col = 0; col < 4; col++) {
                int value = grid[row][col];
                int x = startX + gap + col * (cellSize + gap);
                int y = startY + gap + row * (cellSize + gap);

                drawTile(g2, value, x, y, cellSize);
            }
        }
    }

    private void drawTile(Graphics2D g2, int value, int x, int y, int size) {
        g2.setColor(getTileColor(value));
        g2.fillRoundRect(x, y, size, size, 16, 16);

        if (value == 0) {
            return;
        }

        if (value <= 4) {
            g2.setColor(new Color(119, 110, 101));
        } else {
            g2.setColor(Color.WHITE);
        }

        g2.setFont(getTileFont(value));

        String text = String.valueOf(value);
        FontMetrics metrics = g2.getFontMetrics();
        int textX = x + (size - metrics.stringWidth(text)) / 2;
        int textY = y + ((size - metrics.getHeight()) / 2) + metrics.getAscent();

        g2.drawString(text, textX, textY);
    }

    private Color getTileColor(int value) {
        switch (value) {
            case 0:
                return new Color(205, 193, 180);
            case 2:
                return new Color(238, 228, 218);
            case 4:
                return new Color(237, 224, 200);
            case 8:
                return new Color(242, 177, 121);
            case 16:
                return new Color(245, 149, 99);
            case 32:
                return new Color(246, 124, 95);
            case 64:
                return new Color(246, 94, 59);
            case 128:
                return new Color(237, 207, 114);
            case 256:
                return new Color(237, 204, 97);
            case 512:
                return new Color(237, 200, 80);
            case 1024:
                return new Color(237, 197, 63);
            case 2048:
                return new Color(237, 194, 46);
            default:
                return new Color(60, 58, 50);
        }
    }

    private Font getTileFont(int value) {
        if (value < 100) {
            return new Font("Arial", Font.BOLD, 38);
        } else if (value < 1000) {
            return new Font("Arial", Font.BOLD, 32);
        } else {
            return new Font("Arial", Font.BOLD, 25);
        }
    }
}

class Game2048 {
    private static final int SIZE = 4;
    private final int[][] grid;
    private final Random random;
    private final Preferences preferences;
    private final String bestScoreKey;

    private int score;
    private int bestScore;
    private boolean gameOver;
    private boolean hasWon;

    public Game2048(String bestScoreKey) {
        this.grid = new int[SIZE][SIZE];
        this.random = new Random();
        this.preferences = Preferences.userNodeForPackage(Game2048.class);
        this.bestScoreKey = bestScoreKey;
        this.bestScore = preferences.getInt(bestScoreKey, 0);
        reset();
    }

    public void reset() {
        for (int row = 0; row < SIZE; row++) {
            for (int col = 0; col < SIZE; col++) {
                grid[row][col] = 0;
            }
        }

        score = 0;
        gameOver = false;
        hasWon = false;

        addRandomTile();
        addRandomTile();
    }

    public boolean move(Direction direction, boolean stopAt2048) {
        if (gameOver) {
            return false;
        }

        if (stopAt2048 && hasWon) {
            return false;
        }

        int[][] oldGrid = copyGrid();
        int gainedScore = 0;

        switch (direction) {
            case LEFT:
                gainedScore = moveLeft();
                break;
            case RIGHT:
                gainedScore = moveRight();
                break;
            case UP:
                gainedScore = moveUp();
                break;
            case DOWN:
                gainedScore = moveDown();
                break;
        }

        if (!gridChanged(oldGrid)) {
            return false;
        }

        score += gainedScore;
        updateBestScore();
        addRandomTile();

        if (contains2048()) {
            hasWon = true;
        }

        if (!canMove()) {
            gameOver = true;
        }

        return true;
    }

    private int moveLeft() {
        int gainedScore = 0;

        for (int row = 0; row < SIZE; row++) {
            MergeResult result = slideAndMerge(grid[row]);
            grid[row] = result.line;
            gainedScore += result.score;
        }

        return gainedScore;
    }

    private int moveRight() {
        int gainedScore = 0;

        for (int row = 0; row < SIZE; row++) {
            int[] reversed = reverse(grid[row]);
            MergeResult result = slideAndMerge(reversed);
            grid[row] = reverse(result.line);
            gainedScore += result.score;
        }

        return gainedScore;
    }

    private int moveUp() {
        int gainedScore = 0;

        for (int col = 0; col < SIZE; col++) {
            int[] column = getColumn(col);
            MergeResult result = slideAndMerge(column);
            setColumn(col, result.line);
            gainedScore += result.score;
        }

        return gainedScore;
    }

    private int moveDown() {
        int gainedScore = 0;

        for (int col = 0; col < SIZE; col++) {
            int[] column = reverse(getColumn(col));
            MergeResult result = slideAndMerge(column);
            setColumn(col, reverse(result.line));
            gainedScore += result.score;
        }

        return gainedScore;
    }

    private MergeResult slideAndMerge(int[] line) {
        List<Integer> numbers = new ArrayList<Integer>();

        for (int value : line) {
            if (value != 0) {
                numbers.add(value);
            }
        }

        int[] newLine = new int[SIZE];
        int index = 0;
        int gainedScore = 0;

        for (int i = 0; i < numbers.size(); i++) {
            if (i + 1 < numbers.size() && numbers.get(i).equals(numbers.get(i + 1))) {
                int mergedValue = numbers.get(i) * 2;
                newLine[index] = mergedValue;
                index++;
                gainedScore += mergedValue;
                i++;
            } else {
                newLine[index] = numbers.get(i);
                index++;
            }
        }

        return new MergeResult(newLine, gainedScore);
    }

    private void addRandomTile() {
        List<Point> emptyCells = new ArrayList<Point>();

        for (int row = 0; row < SIZE; row++) {
            for (int col = 0; col < SIZE; col++) {
                if (grid[row][col] == 0) {
                    emptyCells.add(new Point(row, col));
                }
            }
        }

        if (emptyCells.isEmpty()) {
            return;
        }

        Point chosenCell = emptyCells.get(random.nextInt(emptyCells.size()));
        grid[chosenCell.x][chosenCell.y] = random.nextDouble() < 0.9 ? 2 : 4;
    }

    private boolean canMove() {
        for (int row = 0; row < SIZE; row++) {
            for (int col = 0; col < SIZE; col++) {
                if (grid[row][col] == 0) {
                    return true;
                }

                if (col < SIZE - 1 && grid[row][col] == grid[row][col + 1]) {
                    return true;
                }

                if (row < SIZE - 1 && grid[row][col] == grid[row + 1][col]) {
                    return true;
                }
            }
        }

        return false;
    }

    private boolean contains2048() {
        for (int row = 0; row < SIZE; row++) {
            for (int col = 0; col < SIZE; col++) {
                if (grid[row][col] >= 2048) {
                    return true;
                }
            }
        }

        return false;
    }

    private int[] getColumn(int col) {
        int[] column = new int[SIZE];

        for (int row = 0; row < SIZE; row++) {
            column[row] = grid[row][col];
        }

        return column;
    }

    private void setColumn(int col, int[] column) {
        for (int row = 0; row < SIZE; row++) {
            grid[row][col] = column[row];
        }
    }

    private int[] reverse(int[] array) {
        int[] reversed = new int[array.length];

        for (int i = 0; i < array.length; i++) {
            reversed[i] = array[array.length - 1 - i];
        }

        return reversed;
    }

    private int[][] copyGrid() {
        int[][] copy = new int[SIZE][SIZE];

        for (int row = 0; row < SIZE; row++) {
            System.arraycopy(grid[row], 0, copy[row], 0, SIZE);
        }

        return copy;
    }

    private boolean gridChanged(int[][] oldGrid) {
        for (int row = 0; row < SIZE; row++) {
            for (int col = 0; col < SIZE; col++) {
                if (grid[row][col] != oldGrid[row][col]) {
                    return true;
                }
            }
        }

        return false;
    }

    private void updateBestScore() {
        if (score > bestScore) {
            bestScore = score;
            preferences.putInt(bestScoreKey, bestScore);
        }
    }

    public int[][] getGrid() {
        int[][] copy = new int[SIZE][SIZE];

        for (int row = 0; row < SIZE; row++) {
            System.arraycopy(grid[row], 0, copy[row], 0, SIZE);
        }

        return copy;
    }

    public int getScore() {
        return score;
    }

    public int getBestScore() {
        return bestScore;
    }

    public boolean isGameOver() {
        return gameOver;
    }

    public boolean hasWon() {
        return hasWon;
    }

class GameFrame extends JFrame {
    private PlayerPanel playerOnePanel;
    private PlayerPanel playerTwoPanel;
    private JLabel infoLabel;
    private GameMode currentMode;
    private boolean stopAt2048;

    public GameFrame() {
        setTitle("2048 Offline - Solo dan Versus");
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setSize(1100, 720);
        setLocationRelativeTo(null);
        setResizable(true);

        currentMode = GameMode.MENU;
        stopAt2048 = false;

        setupKeyBindings();
        showMenu();
    }

    private void showMenu() {
        currentMode = GameMode.MENU;
        stopAt2048 = false;
        playerOnePanel = null;
        playerTwoPanel = null;

        getContentPane().removeAll();
        getContentPane().setLayout(new BorderLayout());
        getContentPane().add(createMenuPanel(), BorderLayout.CENTER);

        revalidate();
        repaint();
    }

    private JPanel createMenuPanel() {
        JPanel menuPanel = new JPanel(new GridBagLayout());
        menuPanel.setBackground(new Color(250, 248, 239));

        GridBagConstraints gbc = new GridBagConstraints();
        gbc.gridx = 0;
        gbc.fill = GridBagConstraints.HORIZONTAL;
        gbc.insets = new Insets(8, 16, 8, 16);

        JLabel titleLabel = new JLabel("2048 Offline", SwingConstants.CENTER);
        titleLabel.setFont(new Font("Arial", Font.BOLD, 52));
        titleLabel.setForeground(new Color(119, 110, 101));

        JLabel subtitleLabel = new JLabel("Pilih mode permainan", SwingConstants.CENTER);
        subtitleLabel.setFont(new Font("Arial", Font.PLAIN, 20));
        subtitleLabel.setForeground(new Color(119, 110, 101));

        JButton soloButton = createMenuButton("Mode Solo");
        JButton versusButton = createMenuButton("Mode Versus 2 Pemain");
        JButton exitButton = createMenuButton("Keluar");

        soloButton.addActionListener(new AbstractAction() {
            @Override
            public void actionPerformed(ActionEvent e) {
                startGame(GameMode.SOLO);
            }
        });

        versusButton.addActionListener(new AbstractAction() {
            @Override
            public void actionPerformed(ActionEvent e) {
                startGame(GameMode.VERSUS);
            }
        });

        exitButton.addActionListener(new AbstractAction() {
            @Override
            public void actionPerformed(ActionEvent e) {
                dispose();
            }
        });

        gbc.gridy = 0;
        menuPanel.add(titleLabel, gbc);

        gbc.gridy = 1;
        menuPanel.add(subtitleLabel, gbc);

        gbc.gridy = 2;
        gbc.insets = new Insets(30, 16, 8, 16);
        menuPanel.add(soloButton, gbc);

        gbc.gridy = 3;
        gbc.insets = new Insets(8, 16, 8, 16);
        menuPanel.add(versusButton, gbc);

        gbc.gridy = 4;
        menuPanel.add(exitButton, gbc);

        JLabel noteLabel = new JLabel(
                "Solo: WASD atau tombol panah | Versus: Pemain 1 WASD, Pemain 2 tombol panah",
                SwingConstants.CENTER
        );
        noteLabel.setFont(new Font("Arial", Font.PLAIN, 14));
        noteLabel.setForeground(new Color(119, 110, 101));

        gbc.gridy = 5;
        gbc.insets = new Insets(26, 16, 8, 16);
        menuPanel.add(noteLabel, gbc);

        return menuPanel;
    }

    private JButton createMenuButton(String text) {
        JButton button = new JButton(text);
        button.setFont(new Font("Arial", Font.BOLD, 20));
        button.setForeground(Color.WHITE);
        button.setBackground(new Color(143, 122, 102));
        button.setFocusPainted(false);
        button.setPreferredSize(new Dimension(330, 52));
        return button;
    }

    private void startGame(GameMode mode) {
        currentMode = mode;
        stopAt2048 = false;

        if (mode == GameMode.SOLO) {
            Game2048 soloGame = new Game2048("bestScoreSolo");
            playerOnePanel = new PlayerPanel("Pemain Solo", "Kontrol: W A S D atau tombol panah", soloGame);
            playerTwoPanel = null;
        } else {
            Game2048 playerOneGame = new Game2048("bestScorePlayerOne");
            Game2048 playerTwoGame = new Game2048("bestScorePlayerTwo");
            playerOnePanel = new PlayerPanel("Pemain 1", "Kontrol: W A S D", playerOneGame);
            playerTwoPanel = new PlayerPanel("Pemain 2", "Kontrol: Tombol Panah", playerTwoGame);
        }

        infoLabel = new JLabel(" ", SwingConstants.CENTER);
        infoLabel.setFont(new Font("Arial", Font.BOLD, 22));
        infoLabel.setForeground(new Color(119, 110, 101));
        infoLabel.setBorder(BorderFactory.createEmptyBorder(8, 8, 14, 8));

        getContentPane().removeAll();
        getContentPane().setLayout(new BorderLayout(10, 10));
        getContentPane().add(createGameHeader(mode), BorderLayout.NORTH);
        getContentPane().add(createGameArea(mode), BorderLayout.CENTER);
        getContentPane().add(infoLabel, BorderLayout.SOUTH);

        revalidate();
        repaint();
    }

    private JPanel createGameHeader(GameMode mode) {
        JPanel header = new JPanel(new BorderLayout());
        header.setBackground(new Color(250, 248, 239));
        header.setBorder(BorderFactory.createEmptyBorder(16, 20, 12, 20));

        String titleText = mode == GameMode.SOLO ? "2048 Solo" : "2048 Versus";
        String subtitleText = mode == GameMode.SOLO
                ? "Gabungkan angka yang sama sampai mencapai 2048."
                : "Pemain 1 memakai W A S D, Pemain 2 memakai tombol panah. Skor tertinggi menang.";

        JLabel title = new JLabel(titleText, SwingConstants.CENTER);
        title.setFont(new Font("Arial", Font.BOLD, 42));
        title.setForeground(new Color(119, 110, 101));

        JLabel subtitle = new JLabel(subtitleText, SwingConstants.CENTER);
        subtitle.setFont(new Font("Arial", Font.PLAIN, 15));
        subtitle.setForeground(new Color(119, 110, 101));

        JPanel textPanel = new JPanel(new GridLayout(2, 1));
        textPanel.setBackground(new Color(250, 248, 239));
        textPanel.add(title);
        textPanel.add(subtitle);

        JPanel buttonPanel = new JPanel(new FlowLayout(FlowLayout.CENTER, 12, 8));
        buttonPanel.setBackground(new Color(250, 248, 239));

        JButton backButton = new JButton("Kembali ke Menu");
        JButton restartButton = new JButton("Restart");
        JButton modeButton = new JButton("Mode: Lanjut Setelah 2048");

        backButton.addActionListener(new AbstractAction() {
            @Override
            public void actionPerformed(ActionEvent e) {
                showMenu();
            }
        });

        restartButton.addActionListener(new AbstractAction() {
            @Override
            public void actionPerformed(ActionEvent e) {
                restartGame();
            }
        });

        modeButton.addActionListener(new AbstractAction() {
            @Override
            public void actionPerformed(ActionEvent e) {
                stopAt2048 = !stopAt2048;
                if (stopAt2048) {
                    modeButton.setText("Mode: Stop Saat 2048");
                } else {
                    modeButton.setText("Mode: Lanjut Setelah 2048");
                }
                refreshPlayers();
                checkEndCondition();
            }
        });

        buttonPanel.add(backButton);
        buttonPanel.add(restartButton);
        buttonPanel.add(modeButton);

        header.add(textPanel, BorderLayout.CENTER);
        header.add(buttonPanel, BorderLayout.SOUTH);
        return header;
    }

    private JPanel createGameArea(GameMode mode) {
        JPanel area = new JPanel(new GridBagLayout());
        area.setBackground(new Color(250, 248, 239));
        area.setBorder(BorderFactory.createEmptyBorder(10, 20, 10, 20));

        GridBagConstraints gbc = new GridBagConstraints();
        gbc.gridy = 0;
        gbc.fill = GridBagConstraints.BOTH;
        gbc.weighty = 1;

        if (mode == GameMode.SOLO) {
            gbc.gridx = 0;
            gbc.weightx = 1;
            gbc.insets = new Insets(0, 160, 0, 160);
            area.add(playerOnePanel, gbc);
            return area;
        }

        gbc.gridx = 0;
        gbc.weightx = 1;
        gbc.insets = new Insets(0, 0, 0, 0);
        area.add(playerOnePanel, gbc);

        JLabel versusLabel = new JLabel("VS", SwingConstants.CENTER);
        versusLabel.setFont(new Font("Arial", Font.BOLD, 28));
        versusLabel.setForeground(Color.WHITE);
        versusLabel.setOpaque(true);
        versusLabel.setBackground(new Color(187, 173, 160));
        versusLabel.setPreferredSize(new Dimension(70, 70));

        gbc.gridx = 1;
        gbc.weightx = 0;
        gbc.insets = new Insets(0, 16, 0, 16);
        area.add(versusLabel, gbc);

        gbc.gridx = 2;
        gbc.weightx = 1;
        gbc.insets = new Insets(0, 0, 0, 0);
        area.add(playerTwoPanel, gbc);

        return area;
    }

    private void setupKeyBindings() {
        JRootPane rootPane = getRootPane();

        bindKey(rootPane, "pressed W", "p1_up", new Runnable() {
            @Override
            public void run() {
                handleMove(true, Direction.UP);
            }
        });

        bindKey(rootPane, "pressed A", "p1_left", new Runnable() {
            @Override
            public void run() {
                handleMove(true, Direction.LEFT);
            }
        });

        bindKey(rootPane, "pressed S", "p1_down", new Runnable() {
            @Override
            public void run() {
                handleMove(true, Direction.DOWN);
            }
        });

        bindKey(rootPane, "pressed D", "p1_right", new Runnable() {
            @Override
            public void run() {
                handleMove(true, Direction.RIGHT);
            }
        });

        bindKey(rootPane, "pressed UP", "p2_up", new Runnable() {
            @Override
            public void run() {
                handleMove(false, Direction.UP);
            }
        });

        bindKey(rootPane, "pressed LEFT", "p2_left", new Runnable() {
            @Override
            public void run() {
                handleMove(false, Direction.LEFT);
            }
        });

        bindKey(rootPane, "pressed DOWN", "p2_down", new Runnable() {
            @Override
            public void run() {
                handleMove(false, Direction.DOWN);
            }
        });

        bindKey(rootPane, "pressed RIGHT", "p2_right", new Runnable() {
            @Override
            public void run() {
                handleMove(false, Direction.RIGHT);
            }
        });
    }

    private void bindKey(JRootPane rootPane, String keyStrokeText, String actionName, final Runnable action) {
        rootPane.getInputMap(JComponent.WHEN_IN_FOCUSED_WINDOW)
                .put(KeyStroke.getKeyStroke(keyStrokeText), actionName);

        rootPane.getActionMap().put(actionName, new AbstractAction() {
            @Override
            public void actionPerformed(ActionEvent e) {
                action.run();
            }
        });
    }

    private void handleMove(boolean playerOneKey, Direction direction) {
        if (currentMode == GameMode.MENU) {
            return;
        }

        if (currentMode == GameMode.SOLO) {
            movePlayer(playerOnePanel, direction);
            return;
        }

        if (playerOneKey) {
            movePlayer(playerOnePanel, direction);
        } else {
            movePlayer(playerTwoPanel, direction);
        }
    }

    private void movePlayer(PlayerPanel playerPanel, Direction direction) {
        if (playerPanel == null) {
            return;
        }

        boolean moved = playerPanel.getGame().move(direction, stopAt2048);

        if (moved) {
            playerPanel.updateView(stopAt2048);
            checkEndCondition();
        }
    }

    private void restartGame() {
        if (currentMode == GameMode.MENU) {
            return;
        }

        if (playerOnePanel != null) {
            playerOnePanel.getGame().reset();
        }

        if (playerTwoPanel != null) {
            playerTwoPanel.getGame().reset();
        }

        refreshPlayers();
        infoLabel.setText(" ");
    }

    private void refreshPlayers() {
        if (playerOnePanel != null) {
            playerOnePanel.updateView(stopAt2048);
        }

        if (playerTwoPanel != null) {
            playerTwoPanel.updateView(stopAt2048);
        }
    }

    private void checkEndCondition() {
        if (currentMode == GameMode.SOLO) {
            checkSoloEndCondition();
        } else if (currentMode == GameMode.VERSUS) {
            checkVersusEndCondition();
        }
    }

    private void checkSoloEndCondition() {
        Game2048 game = playerOnePanel.getGame();

        if (game.isGameOver()) {
            infoLabel.setText("Game Over! Skor akhir: " + game.getScore());
            return;
        }

        if (stopAt2048 && game.hasWon()) {
            infoLabel.setText("Selamat! Kamu mencapai 2048. Skor akhir: " + game.getScore());
            return;
        }

        infoLabel.setText(" ");
    }

    private void checkVersusEndCondition() {
        Game2048 gameOne = playerOnePanel.getGame();
        Game2048 gameTwo = playerTwoPanel.getGame();

        boolean playerOneDone = gameOne.isGameOver() || (stopAt2048 && gameOne.hasWon());
        boolean playerTwoDone = gameTwo.isGameOver() || (stopAt2048 && gameTwo.hasWon());

        if (!playerOneDone || !playerTwoDone) {
            infoLabel.setText(" ");
            return;
        }

        int scoreOne = gameOne.getScore();
        int scoreTwo = gameTwo.getScore();

        if (scoreOne > scoreTwo) {
            infoLabel.setText("Pemain 1 menang! Skor " + scoreOne + " vs " + scoreTwo);
        } else if (scoreTwo > scoreOne) {
            infoLabel.setText("Pemain 2 menang! Skor " + scoreTwo + " vs " + scoreOne);
        } else {
            infoLabel.setText("Seri! Kedua pemain mendapat skor " + scoreOne);
        }
    }
}

